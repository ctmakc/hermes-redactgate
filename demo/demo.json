{
  "cmd": ["bash", "--norc", "--noprofile", "-i"],
  "steps": [
    {"sleep": 0.5, "mark": "start"},
    {"type": "hermes", "cps_delay": 0.06},
    {"sleep": 0.3, "enter": true},
    {"wait": "Type your message", "timeout": 60},
    {"sleep": 2.5, "mark": "typing"},
    {"type": "My client Jane Doe (jane.doe@acme-corp.com, +1 613 555 0142) was charged twice on card 4111 1111 1111 1111. Write her a 2-line apology that greets her by name and mentions her email, and save it to apology.txt", "cps_delay": 0.016},
    {"sleep": 0.6, "enter": true, "mark": "sent"},
    {"wait": "─ \\d+(\\.\\d+)?s · ", "timeout": 150, "mark": "done"},
    {"sleep": 3.0, "mark": "last"},
    {"type": "/redact last", "cps_delay": 0.05},
    {"sleep": 0.5, "enter": true},
    {"wait": "Placeholders", "timeout": 20},
    {"sleep": 7.0, "mark": "audit"},
    {"type": "/redact audit 6", "cps_delay": 0.05},
    {"sleep": 0.5, "enter": true},
    {"wait": "Audit journal", "timeout": 20},
    {"sleep": 5.0, "mark": "verify"},
    {"type": "/redact verify", "cps_delay": 0.05},
    {"sleep": 0.5, "enter": true},
    {"wait": "chain intact", "timeout": 20},
    {"sleep": 2.0, "mark": "exit"},
    {"type": "/exit", "cps_delay": 0.05},
    {"sleep": 0.4, "enter": true},
    {"wait": "demo \\$", "timeout": 30, "mark": "cat"},
    {"type": "cat apology.txt", "cps_delay": 0.05, "enter": true},
    {"sleep": 4.5}
  ],
  "tail": 0.5
}
