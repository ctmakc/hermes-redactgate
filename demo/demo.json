{
  "cmd": ["bash", "--norc", "--noprofile", "-i"],
  "steps": [
    {"sleep": 1.0},
    {"type": "hermes plugins list --plain --no-bundled", "enter": true},
    {"wait": "redactgate", "timeout": 30},
    {"sleep": 2.5},
    {"type": "clear; hermes", "enter": true},
    {"wait": "Type your message", "timeout": 60},
    {"sleep": 3.0},
    {"type": "My client Jane Doe (jane.doe@acme-corp.com, +1 613 555 0142) was charged twice on card 4111 1111 1111 1111. Write her a 2-line apology that greets her by name and mentions her email, and save it to apology.txt", "cps_delay": 0.02},
    {"sleep": 0.8, "enter": true},
    {"wait": "─ \\d+(\\.\\d+)?s · ", "timeout": 150},
    {"sleep": 3.5},
    {"type": "/redact last", "cps_delay": 0.06},
    {"sleep": 0.6, "enter": true},
    {"wait": "Placeholders", "timeout": 20},
    {"sleep": 7.0},
    {"type": "/redact audit 6", "cps_delay": 0.06},
    {"sleep": 0.6, "enter": true},
    {"wait": "Audit journal", "timeout": 20},
    {"sleep": 4.5},
    {"type": "/redact verify", "cps_delay": 0.06},
    {"sleep": 0.6, "enter": true},
    {"wait": "chain intact", "timeout": 20},
    {"sleep": 2.5},
    {"type": "/exit", "cps_delay": 0.06},
    {"sleep": 0.6, "enter": true},
    {"wait": "demo \\$", "timeout": 30},
    {"type": "cat apology.txt", "enter": true},
    {"sleep": 4.0}
  ],
  "tail": 1
}
